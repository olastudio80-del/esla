# Подключение к облаку для раздела «Ota-onam».
#
# Эти значения публичные: они попадают в APK и видны любому, кто его
# распакует. Безопасность держится на разграничении доступа к строкам
# в базе, а не на тайне ключа. Секретные ключи (service_role) здесь
# не нужны и в приложение попадать не должны никогда.
#
# Без этих переменных приложение работает полностью — просто без связи
# телефонов родителя и ребёнка.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
